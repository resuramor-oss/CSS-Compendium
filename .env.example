# Public site URL, used for metadata and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings (Project Settings -> API).
# Use the publishable key (sb_publishable_...) on the Free plan.
# A legacy anon key also works as NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Leave these blank to run the site in public-only mode without accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
